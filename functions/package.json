{
  "name": "driving-school-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node scripts/seed-emulator.mjs",
    "test:rules": "vitest run --config vitest.rules.config.ts",
